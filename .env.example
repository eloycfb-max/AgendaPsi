# Variáveis de ambiente do HumanaMentePsi.
# Copie para `.env` e ajuste. No servidor, o deploy/oracle/setup-oracle.sh
# cria o `.env` automaticamente.

# Senha do administrador usada APENAS na primeira execução (seed do banco).
# Depois que o banco existir, a variável é ignorada.
ADMIN_SENHA_INICIAL=troque-por-uma-senha-forte
